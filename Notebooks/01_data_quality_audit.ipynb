    "\n",
    "# Step 3F: Check the missing-value patterns\n",
    "\n",
    "# 1. Check whether missing Internet Type matches Internet Service = No\n",
    "print(\"1. Internet service and internet type\")\n",
    "\n",
    "if {\"Internet Service\", \"Internet Type\"}.issubset(df.columns):\n",
    "    display(pd.crosstab(\n",
    "        df[\"Internet Service\"].fillna(\"MISSING\"),\n",
    "        df[\"Internet Type\"].fillna(\"MISSING\"),\n",
    "        margins=True\n",
    "    ))\n",
    "\n",
    "    print(\n",
    "        \"Internet Type missing while Internet Service = Yes:\",\n",
    "        (\n",
    "            df[\"Internet Type\"].isna()\n",
    "            & df[\"Internet Service\"].eq(\"Yes\")\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "    print(\n",
    "        \"Internet Type present while Internet Service = No:\",\n",
    "        (\n",
    "            df[\"Internet Type\"].notna()\n",
    "            & df[\"Internet Service\"].eq(\"No\")\n",
    "        ).sum()\n",
    "    )\n",
    "\n",
    "# 2. Check whether these two columns are missing for the same customers\n",
    "print(\"\\n2. Multiple lines and long-distance charges\")\n",
    "\n",
    "if {\n",
    "    \"Multiple Lines\",\n",
    "    \"Avg Monthly Long Distance Charges\"\n",
    "}.issubset(df.columns):\n",
    "    a = df[\"Multiple Lines\"].isna()\n",
    "    b = df[\"Avg Monthly Long Distance Charges\"].isna()\n",
    "\n",
    "    print(\"Missing Multiple Lines:\", a.sum())\n",
    "    print(\"Missing Long Distance Charges:\", b.sum())\n",
    "    print(\"Both missing:\", (a & b).sum())\n",
    "    print(\"Only Multiple Lines missing:\", (a & ~b).sum())\n",
    "    print(\"Only Long Distance Charges missing:\", (~a & b).sum())\n",
    "\n",
    "# 3. Check the churn fields\n",
    "print(\"\\n3. Churn fields\")\n",
    "\n",
    "for col in [\"Churn Category\", \"Churn Reason\"]:\n",
    "    if col in df.columns:\n",
    "        print(f\"\\n{col}:\")\n",
    "        display(pd.crosstab(\n",
    "            df[\"Customer Status\"],\n",
    "            df[col].isna().map({\n",
    "                True: \"Missing\",\n",
    "                False: \"Present\"\n",
    "            })\n",
    "        ))\n",
    "\n",
    "# 4. Summarize negative monthly charges without changing the data\n",
    "print(\"\\n4. Negative monthly charges\")\n",
    "\n",
    "negative_mask = df[\"Monthly Charge\"] < 0\n",
    "print(\"Negative charge records:\", negative_mask.sum())\n",
    "print(\n",
    "    \"Percentage of dataset:\",\n",
    "    round(negative_mask.mean() * 100, 2),\n",
    "    \"%\"\n",
    ")\n",
    "print(\n",
    "    \"Negative charge records with missing Total Charges:\",\n",
    "    (\n",
    "        negative_mask\n",
    "        & df[\"Total Charges\"].isna()\n",
    "    ).sum()\n",
    ")\n",
    "\n",
   ]
