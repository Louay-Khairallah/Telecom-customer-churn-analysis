    "\n",
    "# Step 3D: Review unusual monthly charges\n",
    "\n",
    "negative_mask = df[\"Monthly Charge\"] < 0\n",
    "negative_customers = df.loc[negative_mask].copy()\n",
    "\n",
    "print(\"Negative monthly charge review\")\n",
    "print(\"Number of affected records:\", len(negative_customers))\n",
    "\n",
    "# Show the relevant details for these customers\n",
    "columns_to_inspect = [\n",
    "    \"Customer ID\",\n",
    "    \"Customer Status\",\n",
    "    \"Monthly Charge\",\n",
    "    \"Total Charges\",\n",
    "    \"Tenure in Months\",\n",
    "    \"Internet Service\",\n",
    "    \"Internet Type\",\n",
    "    \"Contract\",\n",
    "    \"Offer\",\n",
    "    \"Churn Category\",\n",
    "    \"Churn Reason\",\n",
    "]\n",
    "\n",
    "available_columns = [\n",
    "    col for col in columns_to_inspect if col in df.columns\n",
    "]\n",
    "\n",
    "display(negative_customers[available_columns].head(20))\n",
    "\n",
    "print(\"\\nSummary of negative charges\")\n",
    "display(negative_customers[\"Monthly Charge\"].describe())\n",
    "\n",
    "print(\"\\nNegative charges by customer status\")\n",
    "display(\n",
    "    negative_customers[\"Customer Status\"]\n",
    "    .value_counts(dropna=False)\n",
    ")\n",
    "\n",
    "print(\"\\nContract types for affected customers\")\n",
    "if \"Contract\" in df.columns:\n",
    "    display(\n",
    "        negative_customers[\"Contract\"]\n",
    "        .value_counts(dropna=False)\n",
    "    )\n",
    "\n",
    "print(\"\\nInternet service counts\")\n",
    "if \"Internet Service\" in df.columns:\n",
    "    display(df[\"Internet Service\"].value_counts(dropna=False))\n",
    "\n",
    "print(\"\\nInternet type counts\")\n",
    "if \"Internet Type\" in df.columns:\n",
    "    display(df[\"Internet Type\"].value_counts(dropna=False))\n",
    "\n",
    "print(\"\\nStep 3D complete\")\n"
   ]
