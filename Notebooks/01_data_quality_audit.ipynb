   "source": [
    "\n",
    "# 1. Count missing values in each column\n",
    "missing = df.isna().sum()\n",
    "\n",
    "missing_report = pd.DataFrame({\n",
    "    \"missing_count\": missing,\n",
    "    \"missing_percent\": (missing / len(df) * 100).round(2)\n",
    "})\n",
    "\n",
    "missing_report = missing_report[\n",
    "    missing_report[\"missing_count\"] > 0\n",
    "].sort_values(\"missing_count\", ascending=False)\n",
    "\n",
    "print(\"Missing values\")\n",
    "display(missing_report)\n",
    "\n",
    "# 2. Check for duplicate rows\n",
    "print(\"Duplicate rows:\", df.duplicated().sum())\n",
    "\n",
    "# 3. Check customer IDs\n",
    "print(\"Missing customer IDs:\", df[\"Customer ID\"].isna().sum())\n",
    "print(\"Unique customer IDs:\", df[\"Customer ID\"].nunique())\n",
    "print(\"Total records:\", len(df))\n",
    "\n",
    "# 4. Count customers by status\n",
    "print(\"\\nCustomer status counts\")\n",
    "display(df[\"Customer Status\"].value_counts(dropna=False))\n",
    "\n",
    "# 5. Summarize the numeric columns\n",
    "print(\"\\nNumeric summary\")\n",
    "display(df.describe().T)\n"
   ]
  },
