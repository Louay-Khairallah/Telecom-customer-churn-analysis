    "from pathlib import Path\n",
    "\n",
    "# Create a folder for the report\n",
    "report_dir = Path.cwd().resolve()\n",
    "if not (report_dir / 'data' / 'telecom_customer_churn.csv').exists():\n",
    "    report_dir = report_dir.parent\n",
    "report_dir = report_dir / 'reports' / 'data_quality_audit'\n",
    "report_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# Save the missing-value report\n",
    "missing_report.to_csv(\n",
    "    report_dir / \"missing_values_report.csv\",\n",
    "    index=True,\n",
    "    index_label=\"column\"\n",
    ")\n",
    "\n",
    "print(\"Missing-value report created.\")\n"
   ]
