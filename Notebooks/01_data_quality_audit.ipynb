   "source": [
    "\n",
    "# Step 3A: Review the data quality\n",
    "\n",
    "import pandas as pd\n",
    "\n",
    "print(\"Dataset size\")\n",
    "print(f\"Rows: {len(df):,}\")\n",
    "print(f\"Columns: {df.shape[1]}\")\n",
    "\n",
    "# 1. Check for duplicate customer records\n",
    "print(\"\\nDuplicate checks\")\n",
    "print(\"Duplicate full rows:\", df.duplicated().sum())\n",
    "\n",
    "if \"Customer ID\" in df.columns:\n",
    "    print(\"Missing customer IDs:\", df[\"Customer ID\"].isna().sum())\n",
    "    print(\"Unique customer IDs:\", df[\"Customer ID\"].nunique())\n",
    "    print(\"Repeated customer IDs:\", df[\"Customer ID\"].duplicated().sum())\n",
    "\n",
    "# 2. Review customer status\n",
    "if \"Customer Status\" in df.columns:\n",
    "    print(\"\\nCustomer status counts\")\n",
    "    print(df[\"Customer Status\"].value_counts(dropna=False))\n",
    "\n",
    "    # Calculate churn for customers who stayed or churned.\n",
    "    # Customers who recently joined are left out.\n",
    "    eligible_statuses = df[\"Customer Status\"].isin([\"Stayed\", \"Churned\"])\n",
    "    eligible_customers = df.loc[eligible_statuses, \"Customer Status\"]\n",
    "    denominator = len(eligible_customers)\n",
    "\n",
    "    if denominator > 0:\n",
    "        churn_count = (eligible_customers == \"Churned\").sum()\n",
    "        churn_rate = churn_count / denominator * 100\n",
    "        print(f\"\\nStayed + churned customers: {denominator:,}\")\n",
    "        print(f\"Churn rate among these customers: {churn_rate:.2f}%\")\n",
    "\n",
    "# 3. Review missing values in important columns\n",
    "print(\"\\nMissing values in selected columns\")\n",
    "\n",
    "columns_to_check = [\n",
    "    \"Offer\",\n",
    "    \"Internet Service\",\n",
    "    \"Internet Type\",\n",
    "    \"Multiple Lines\",\n",
    "    \"Avg Monthly Long Distance Charges\",\n",
    "    \"Churn Category\",\n",
    "    \"Churn Reason\",\n",
    "    \"Monthly Charge\",\n",
    "    \"Total Charges\",\n",
    "    \"Tenure in Months\",\n",
    "]\n",
    "\n",
    "available_columns = [c for c in columns_to_check if c in df.columns]\n",
    "\n",
    "if available_columns:\n",
    "    display(\n",
    "        df[available_columns]\n",
    "        .isna()\n",
    "        .sum()\n",
    "        .rename(\"missing_count\")\n",
    "        .to_frame()\n",
    "    )\n",
    "\n",
    "# 4. Compare missing values by customer status\n",
    "print(\"\\nMissing values by customer status\")\n",
    "\n",
    "columns_to_compare = [\n",
    "    c for c in [\n",
    "        \"Offer\",\n",
    "        \"Internet Type\",\n",
    "        \"Churn Category\",\n",
    "        \"Churn Reason\",\n",
    "    ]\n",
    "    if c in df.columns\n",
    "]\n",
    "\n",
    "if columns_to_compare and \"Customer Status\" in df.columns:\n",
    "    for col in columns_to_compare:\n",
    "        print(f\"\\nColumn: {col}\")\n",
    "        display(\n",
    "            df.groupby(\"Customer Status\", dropna=False)[col]\n",
    "            .agg(\n",
    "                total_customers=\"size\",\n",
    "                missing_values=lambda s: s.isna().sum()\n",
    "            )\n",
    "        )\n",
    "\n",
    "# 5. Look for negative values in charge-related columns\n",
    "print(\"\\nNegative values in charge columns\")\n",
    "\n",
    "charge_columns = [\n",
    "    c for c in df.columns\n",
    "    if any(word in c.lower() for word in [\"charge\", \"revenue\", \"refund\"])\n",
    "]\n",
    "\n",
    "found_negative = False\n",
    "\n",
    "for col in charge_columns:\n",
    "    values = pd.to_numeric(df[col], errors=\"coerce\")\n",
    "    negative_count = (values < 0).sum()\n",
    "\n",
    "    if negative_count > 0:\n",
    "        found_negative = True\n",
    "        print(f\"\\n{col}: {negative_count} negative value(s)\")\n",
    "        display(df.loc[values < 0, [col]].head(10))\n",
    "\n",
    "if not found_negative:\n",
    "    print(\"No negative values found in the checked charge-related columns.\")\n",
    "\n",
    "print(\"\\nStep 3A complete\")\n"
   ]
