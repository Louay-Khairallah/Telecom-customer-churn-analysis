table telecom_customer_churn_cleaned
	lineageTag: f2fa57bc-36a3-439a-8335-beb3a08cb7ec

	measure 'Churned Customers' =
			
			CALCULATE(
			    COUNTROWS('telecom_customer_churn_cleaned'),
			    'telecom_customer_churn_cleaned'[Customer Status] = "Churned"
			)
		formatString: #,0
		lineageTag: 55736c0d-7d67-49ca-9a2f-bf474fba6dca

	measure 'Eligible Customers' =
			
			CALCULATE(
			    COUNTROWS('telecom_customer_churn_cleaned'),
			    'telecom_customer_churn_cleaned'[Customer Status] IN {"Stayed", "Churned"}
			)
		formatString: #,0
		lineageTag: a4f5c999-8dab-4104-9506-82242757e58f

	measure 'Churn Rate' =
			
			DIVIDE([Churned Customers], [Eligible Customers])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a82720e9-c537-4a32-94ea-3da67ca0f188

	measure 'Negative Monthly Charge Records' =
			
			CALCULATE(
			    COUNTROWS('telecom_customer_churn_cleaned'),
			    'telecom_customer_churn_cleaned'[Monthly Charge] < 0
			)
		formatString: #,0
		lineageTag: 776834fc-d511-4f0e-af78-94ff35c1e0f0

	measure 'Overall Churn Rate' =
			
			CALCULATE([Churn Rate], ALL('telecom_customer_churn_cleaned'))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c4e933af-2345-448d-82c0-a18e71b42c86

	measure 'Churn Bar Color' =
			
			IF([Churn Rate] > [Overall Churn Rate], "#C4375B", "#2F7F7A")
		isHidden
		lineageTag: c8edbfe2-1e12-47d0-b7e3-1a603529770d

