	column 'Tenure Band' =
			
			SWITCH(
			    TRUE(),
			    'telecom_customer_churn_cleaned'[Tenure in Months] <= 6, "0-6",
			    'telecom_customer_churn_cleaned'[Tenure in Months] <= 12, "7-12",
			    'telecom_customer_churn_cleaned'[Tenure in Months] <= 24, "13-24",
			    'telecom_customer_churn_cleaned'[Tenure in Months] <= 48, "25-48",
			    'telecom_customer_churn_cleaned'[Tenure in Months] <= 72, "49-72",
			    "73+"
			)
		lineageTag: 60d04260-0d29-4051-a9df-8fa151a68b81
		summarizeBy: none
		sortByColumn: 'Tenure Band Sort'

		annotation SummarizationSetBy = Automatic

	column 'Tenure Band Sort' =
			
			SWITCH(
			    TRUE(),
			    'telecom_customer_churn_cleaned'[Tenure in Months] <= 6, 1,
			    'telecom_customer_churn_cleaned'[Tenure in Months] <= 12, 2,
			    'telecom_customer_churn_cleaned'[Tenure in Months] <= 24, 3,
			    'telecom_customer_churn_cleaned'[Tenure in Months] <= 48, 4,
			    'telecom_customer_churn_cleaned'[Tenure in Months] <= 72, 5,
			    6
			)
		isHidden
		formatString: 0
		lineageTag: 35df545b-eb6b-46ad-80f2-f89cf9a2655f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

